// Place your settings in this file to overwrite default and user settings.
{
    // Unofficially, QMK uses spaces for indentation
    "editor.insertSpaces": true,
    // Configure glob patterns for excluding files and folders.
    "files.exclude": {
        "**/.build": true,
        "**/*.hex": true,
        "**/*.bin": true,
        "**/*.uf2": true
    },
    "files.associations": {
        // QMK Filetypes
        "keyboard.json": "jsonc",
        "info.json": "jsonc",
        "keymap.json": "jsonc",
        "qmk.json": "jsonc",
        "qmk_module.json": "jsonc",
        // Standard filetypes
        "*.h": "c",
        "*.c": "c",
        "*.inc": "c",
        "*.cpp": "cpp",
        "*.hpp": "cpp",
        "xstddef": "c",
        "type_traits": "c",
        "utility": "c",
        "ranges": "c"
    },
    "[markdown]": {
        "editor.trimAutoWhitespace": false,
        "files.trimTrailingWhitespace": false
    },
    "python.formatting.provider": "yapf",
    "[json]": {
        "editor.formatOnSave": false
    },
    "clangd.arguments": ["--header-insertion=never"],
    "json.schemas": [
        {
            "fileMatch": ["qmk.json"],
            "url": "./data/schemas/user_repo_v1_1.jsonschema"
        },
        {
            "fileMatch": ["qmk_module.json"],
            "url": "./data/schemas/community_module.jsonschema"
        },
        {
            "fileMatch": ["keyboard.json", "info.json"],
            "url": "./data/schemas/keyboard.jsonschema"
        },
        {
            "fileMatch": ["keymap.json"],
            "url": "./data/schemas/keymap.jsonschema"
        }
    ],
    "cmake.sourceDirectory": "/Users/maxim/qmk_firmware/lib/googletest",
    "chat.tools.terminal.autoApprove": {
        "/^python3 -c 'import json; from pathlib import Path; p=Path\\(\"keyboards/ymdk/yd60mq/keyboard\\.json\"\\); d=json\\.loads\\(p\\.read_text\\(\\)\\); a=d\\[\"layouts\"\\]\\[\"LAYOUT_all\"\\]\\[\"layout\"\\]; print\\(\"YD macro positions\",len\\(a\\)\\); from collections import Counter; print\\(Counter\\(tuple\\(x\\[\"matrix\"\\]\\)\\[0\\] for x in a\\)\\); print\\(\\[x\\[\"matrix\"\\] for x in a if x\\[\"matrix\"\\]\\[0\\]==4\\]\\); p=Path\\(\"keyboards/ymdk/dk61/via\\.json\"\\); d=json\\.loads\\(p\\.read_text\\(\\)\\); print\\(\"DK via rows\"\\); print\\(\\[\\[x for x in r if isinstance\\(x,str\\) and \",\" in x\\] for r in d\\[\"layouts\"\\]\\[\"keymap\"\\]\\]\\)'$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^python3 -m json\\.tool keyboards/ymdk/dk61/keyboard\\.json >/dev/null && git diff --check -- keyboards/ymdk/dk61/keymaps/default/keymap\\.c keyboards/ymdk/dk61/keyboard\\.json && git status --short -- keyboards/ymdk/dk61/keymaps/default/keymap\\.c keyboards/ymdk/dk61/keyboard\\.json$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}
